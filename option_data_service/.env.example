DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/options_db
OPTION_SYMBOL=SPY
POLL_INTERVAL_SECONDS=60

# Schwab (developer.schwab.com) - run scripts/schwab_authorize.py after setting the first
# three of these to obtain SCHWAB_REFRESH_TOKEN (see README)
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
# SCHWAB_REDIRECT_URI=https://127.0.0.1:8182
# SCHWAB_REFRESH_TOKEN=

# Tradier - free signup at tradier.com, then generate a Sandbox token instantly at
# https://web.tradier.com/user/api (no approval wait, delayed data)
# TRADIER_ACCESS_TOKEN=
# TRADIER_ENV=sandbox

# Alpaca - free paper-trading signup (email only, no approval wait) at alpaca.markets,
# generate keys from the dashboard
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# Cboe DataShop (datashop.cboe.com) - path depends on your subscription, see README
# CBOE_API_USERNAME=
# CBOE_API_PASSWORD=
# CBOE_OPTION_CHAIN_PATH=

# Bloomberg Desktop/Server API - defaults match a local Bloomberg Terminal session
# BLOOMBERG_HOST=localhost
# BLOOMBERG_PORT=8194
